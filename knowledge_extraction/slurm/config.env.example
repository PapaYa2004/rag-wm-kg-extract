# Copy to config.env (git-ignored) and edit the lines marked EDIT.
#   cp slurm/config.env.example slurm/config.env
# Every script sources this file.

# ---- EDIT: your NT project space (/fred/<project_id>) and Slurm account ----
PROJECT_ID="ozXXX"                                   # EDIT
WORK="/fred/${PROJECT_ID}/${USER}"
SLURM_ACCOUNT=""                                     # EDIT if your project requires --account; else leave empty

# ---- code: derived from where this file lives (the git clone) ----
KE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_DIR="$(dirname "${KE_DIR}")"
KGGEN_SRC="${REPO_DIR}/kg-gen/src"                    # vendored kg-gen checkout (see README: not PyPI 0.4.0)

# ---- RAG-WM run on OzSTAR (slurm/submit.sh ragwm) ----
RAGWM_DIR="${REPO_DIR}/rag-wm"                        # unmodified RAG-WM code
RAGWM_WORK="${WORK}/ragwm"
CHROMA_DIR="${RAGWM_WORK}/chromadb_db"                # watermarked Chroma store (replaces /workspace/ragwm/ragwm/chromadb_db)
RAGWM_OUTPUT="${RAGWM_WORK}/output"                   # RAG-WM --basepath: wm_prepare/, wm_generate/ (ground truth!)
RAGWM_DATASETS_DIR="${RAGWM_WORK}/datasets"           # BEIR layout RAG-WM's loader expects (corpus.jsonl ...)
VENV_RAGWM="${WORK}/venvs/ragwm"
RAGWM_HF_MODEL="Qwen/Qwen2.5-7B-Instruct"             # watermark-side LLM; deliberately != the extractor's model
RAGWM_SERVED_NAME="gpt-3.5-turbo"                     # name RAG-WM's code asks for (hard-coded in its entity step)
RAGWM_ENTITY_NUM=100                                  # RAG-WM README defaults
RAGWM_EDGE_PROB=0.05
MUTUAL_TIMES=10
TIKTOKEN_CACHE_DIR="${WORK}/tiktoken_cache"

DATASET="nfcorpus"
COLLECTION="${DATASET}_contriever_cosine"

# ---- which watermarked KB the extractor reads ----
#  beir   : datasets/<ds>/<ds>_watermarked.jsonl (built by `submit.sh datasets`; doc_id = BEIR _id)
#  chroma : export straight from the Chroma store (doc_id = Chroma id_<n>)
KB_SOURCE="beir"
DATASETS_DIR="${REPO_DIR}/datasets"
WM_CORPUS="${DATASETS_DIR}/${DATASET}/${DATASET}_watermarked.jsonl"
GT_BEIR="${DATASETS_DIR}/_ground_truth/${DATASET}/rag_wm_ground_truth.json"   # eval only

# ---- outputs / caches (all on /fred; $HOME is only 20 GB) ----
OUT_ROOT="${WORK}/kg_extract_outputs"
KB_JSONL="${OUT_ROOT}/kb/${DATASET}.${KB_SOURCE}.kb.jsonl"
CHROMA_KB_JSONL="${OUT_ROOT}/kb/${DATASET}.chroma.kb.jsonl"
HF_HOME="${WORK}/hf_cache"
NLTK_DATA="${WORK}/nltk_data"                         # kg-gen fetches punkt at import time
DSPY_CACHEDIR="${WORK}/dspy_cache/${DATASET}"
APPTAINER_CACHEDIR="${WORK}/apptainer_cache"
LOG_DIR="${OUT_ROOT}/logs"

# ---- python ----
PY_MODULE="python-scientific/3.11.5-foss-2023b"   # NT: hierarchical modules; any Python >=3.10 (space-separate several)
VENV_CLIENT="${WORK}/venvs/kgx-client"                # kg-gen + dspy + sentence-transformers
VENV_EXPORT="${WORK}/venvs/kgx-export"                # chromadb==0.5.20 only

# ---- LLM served by vLLM inside Apptainer ----
VLLM_IMAGE="docker://vllm/vllm-openai:v0.10.0"
VLLM_SIF="${WORK}/containers/vllm-openai-v0.10.0.sif"
HF_MODEL="meta-llama/Llama-3.1-8B-Instruct"           # gated: accept the licence on huggingface.co first
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_UTIL=0.80                                    # leaves ~16 GB of the A100-80GB for the embedding model
MODEL_TAG="$(basename "${HF_MODEL}")"                 # output dirs are per model: <dataset>[_pilot]_<MODEL_TAG>
KG_MODEL="hosted_vllm/${HF_MODEL}"                    # LiteLLM provider prefix; NOT openai/ (KGGen would switch to the Responses API)
KG_TEMPERATURE=0.0
CONCURRENCY=32                                        # concurrent passages per GPU

# ---- embeddings ----
KG_RETRIEVAL_MODEL="sentence-transformers/all-MiniLM-L6-v2"   # KGGen clustering retrieval model
KG_EVAL_EMBED_MODEL="sentence-transformers/all-MiniLM-L6-v2"  # evaluation fuzzy matching
SEMHASH_MODEL="minishlab/potion-base-8M"                       # used internally by semhash

# ---- pilot ----
PILOT_SAMPLE=300
